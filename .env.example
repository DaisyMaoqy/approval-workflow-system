# Apifox 云端 Mock 前置 URL。
# 留空或请求失败时，应用会自动降级到本地 src/lib/data/seed.json，
# 因此离线 / 未配置环境变量也能完整运行。
PUBLIC_MOCK_BASE_URL=https://m1.apifoxmock.com/m1/8681643-8464991-default

# 数据源开关：'true'=联调后端 /aws/v1；其它值（含留空）= 沿用 Apifox Mock。
# 仅在 USE_BACKEND 为真时把筛选维度（status/keyword/year…）下沉到后端并拆
# 统一信封 {code,data,msg}；Mock 态下 loadRequests 只打 /api/requests，绝不请求 /aws/v1。
PUBLIC_USE_BACKEND=true
